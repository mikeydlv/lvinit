# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# local editor/preview helpers (machine-specific), but track shared subagents
/.claude/*
!/.claude/agents/

# generated GSC opportunity reports (the agent must never commit its own output)
/reports/gsc/

# generated Fact-Decay reports and the source cache (the agent must never
# commit its own output)
/reports/fact-decay/

# generated Internal Linking Agent reports (the agent commits link edits,
# never its own report output)
/reports/internal-links/

# generated Content Brief Generator reports, briefs and handoff queue, plus the
# earlier runs its workflow downloads for history (the agent never commits)
/reports/content-briefs/
/reports/content-briefs-history/

# Local Trend Agent output. In CI it lives on the lvinit-agent-state branch
# (never main); locally these are scratch copies. .agent-state/ is the CI
# checkout of that branch.
/reports/social-trends/
/data/social-trends/
/.agent-state/
# Development Watch (a module of the Local Trend Agent) — same arrangement.
/reports/development-watch/
/data/development-watch/

# earlier Internal Linking reports the workflow downloads for week-to-week
# identity (never written into the output directory, never committed)
/reports/internal-links-history/
