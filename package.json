{
  "name": "lvinit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "gsc:report": "node scripts/gsc/run.mjs",
    "gsc:report:env": "node --env-file=.env scripts/gsc/run.mjs",
    "gsc:report:fixtures": "node scripts/gsc/run.mjs --fixtures",
    "gsc:test": "node --test \"scripts/gsc/test/*.test.mjs\"",
    "fact:report": "node scripts/fact-decay/run.mjs",
    "fact:report:verify": "node scripts/fact-decay/run.mjs --verify",
    "fact:report:fixtures": "node scripts/fact-decay/run.mjs --fixtures",
    "fact:test": "node --test \"scripts/fact-decay/test/*.test.mjs\""
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.40",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
