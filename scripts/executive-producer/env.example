# Copy to %USERPROFILE%\.lvinit\executive-producer\.env and fill in.
# Never commit the filled-in file, and never paste its values into chat.

# Claude: planning, claim checks, frame picking, visual review
ANTHROPIC_API_KEY=

# Apify: Instagram/TikTok research and your own recent posts
APIFY_TOKEN=
LVINIT_INSTAGRAM=mikey_del_rosario
LVINIT_TIKTOK=

# Notifications (Resend; the sender must be on a domain verified in Resend)
RESEND_API_KEY=
LVINIT_NOTIFY_EMAIL=
LVINIT_NOTIFY_FROM=LVINIT <hello@lvinit.com>

# Optional
# LVINIT_VISION_FRAMES=off     keep frame picking fully local (no candidate frames sent to Claude)
# LVINIT_YOUTUBE_CHANNEL=UChMtjruOgmhDJl3efLv8_wA
