# LVINIT environment variables
# Copy the ones you need into your Vercel project (Settings → Environment
# Variables). Nothing here is required to run the site — the contact form
# falls back to a mailto draft and analytics simply stays off until set.

# --- Contact form (Resend) ---
# Create a key at https://resend.com and verify your sending domain (lvinit.com)
# so mail can send from hello@lvinit.com.
RESEND_API_KEY=
# Verified sender. Must be on a domain you've verified in Resend.
CONTACT_FROM_EMAIL="LVINIT <hello@lvinit.com>"
# Where leads are delivered (defaults to hello@lvinit.com if unset).
CONTACT_TO_EMAIL=hello@lvinit.com

# --- Analytics (Google Analytics 4) ---
# Your GA4 Measurement ID, e.g. G-XXXXXXXXXX. Leave blank to keep analytics off.
NEXT_PUBLIC_GA_ID=

# --- Google Search Console Opportunity Agent ---
# Read-only. Used only by scripts/gsc/run.mjs and the weekly GitHub Action.
# See docs/GSC_OPPORTUNITY_AGENT.md for the exact Google Cloud setup steps.
# NEVER commit real values — these are placeholders only.

# The Search Console property, exactly as GSC names it. Either shape works:
#   domain property : sc-domain:lvinit.com
#   URL prefix      : https://www.lvinit.com/
GSC_SITE_URL=sc-domain:lvinit.com

# Service-account credentials. Use EITHER the whole key file as one value...
# (paste the entire downloaded service-account JSON on a single line)
GSC_SERVICE_ACCOUNT_JSON=

# ...OR the two fields from it separately. Literal \n escapes in the key are fine.
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_SERVICE_ACCOUNT_KEY=

# Optional tuning. Everything below has a sensible default — see
# scripts/gsc/config.mjs for the full list of overridable values.
# GSC_PERIOD_DAYS=28
# GSC_LAG_DAYS=3
# GSC_MIN_SCORE=40
# GSC_MAX_OPPORTUNITIES=15
